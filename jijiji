                <div>
                  <div style={{ fontWeight: 600, fontSize: 13.5 }}>{r.subject}</div>
                  <div style={{ fontSize: 11.5, color: C.muted, marginTop: 2 }}>
                    {r.type} · {r.date} · {r.time}
                  </div>
                </div>
                <button
                  onClick={() => removeReminder(r.id)}
                  aria-label="Eliminar recordatorio"
                  style={{ background: "none", border: "none", color: C.muted, cursor: "pointer", fontSize: 16 }}
                >
                  ✕
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

function GoalsScreen({ data, update, minutesToday, weekSessions, onBack }) {
  const [newGoal, setNewGoal] = useState("");
  const [newTarget, setNewTarget] = useState(5);
  const [error, setError] = useState("");

  const dailyPct = Math.min(100, (minutesToday / (data.dailyGoalMin || 60)) * 100);
  const weeklyPct = Math.min(100, (weekSessions / (data.weeklyGoalSessions || 5)) * 100);

  function addGoal() {
    if (!newGoal.trim()) {
      setError("Escribe una meta antes de guardarla.");
      return;
    }
    setError("");
    update((prev) => ({
      ...prev,
      goals: [...(prev.goals || []), { id: uid(), text: newGoal.trim(), target: Number(newTarget) || 1, current: 0 }],
    }));
    setNewGoal("");
  }

  function bumpGoal(id) {
    update((prev) => ({
      ...prev,
      goals: (prev.goals || []).map((g) => (g.id === id ? { ...g, current: Math.min(g.target, g.current + 1) } : g)),
    }));
  }

  function removeGoal(id) {
    update((prev) => ({ ...prev, goals: (prev.goals || []).filter((g) => g.id !== id) }));
  }

  return (
    <div>
      <TopBack onBack={onBack} title="Mis metas" />
      <div style={{ padding: "10px 20px" }}>
        <Card>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, fontWeight: 600 }}>
            <span>🎯 Estudiar {data.dailyGoalMin} min al día</span>
            <span style={{ color: C.muted }}>{Math.round(dailyPct)}%</span>
          </div>
          <div style={{ marginTop: 8 }}>
            <ProgressBar pct={dailyPct} />
          </div>
        </Card>
        <Card style={{ marginTop: 10 }}>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, fontWeight: 600 }}>
            <span>🎯 Completar {data.weeklyGoalSessions} sesiones esta semana</span>
            <span style={{ color: C.muted }}>{Math.round(weeklyPct)}%</span>
          </div>
          <div style={{ marginTop: 8 }}>
            <ProgressBar pct={weeklyPct} color={C.mint} />
          </div>
        </Card>

        <div style={{ marginTop: 20, fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 10 }}>
          Mis metas personales
        </div>
        <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
          {(data.goals || []).map((g) => {
            const pct = Math.min(100, (g.current / g.target) * 100);
            return (
              <Card key={g.id}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                  <div style={{ fontSize: 13, fontWeight: 600, flex: 1 }}>{g.text}</div>
                  <button
                    onClick={() => removeGoal(g.id)}
                    aria-label="Eliminar meta"
                    style={{ background: "none", border: "none", color: C.muted, cursor: "pointer", fontSize: 15 }}
                  >
                    ✕
                  </button>
                </div>
                <div style={{ fontSize: 11.5, color: C.muted, margin: "6px 0 8px" }}>
                  {g.current}/{g.target}
                </div>
                <ProgressBar pct={pct} />
                <GhostButton onClick={() => bumpGoal(g.id)} style={{ marginTop: 10, padding: "8px 14px", fontSize: 12.5 }}>
                  + Avanzar
                </GhostButton>
              </Card>
            );
          })}
        </div>

        <Card style={{ marginTop: 16 }}>
          <TextField label="Nueva meta" value={newGoal} onChange={setNewGoal} placeholder="Ej: Leer 3 capítulos de historia" />
          <TextField label="Objetivo (número)" value={newTarget} onChange={setNewTarget} type="number" />
          {error && <div style={{ color: C.danger, fontSize: 12, marginBottom: 8 }}>{error}</div>}
          <PrimaryButton onClick={addGoal} style={{ width: "100%" }}>
            Agregar meta
          </PrimaryButton>
        </Card>
      </div>
    </div>
  );
}

