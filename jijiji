            <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 20, marginTop: 4 }}>
              {Math.floor(totalMinutesAll / 60)}h {totalMinutesAll % 60}min
            </div>
          </Card>
          <Card>
            <div style={{ fontSize: 11.5, color: C.muted, fontWeight: 600 }}>Sesiones</div>
            <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 20, marginTop: 4 }}>
              {sessions.length}
            </div>
          </Card>
          <Card>
            <div style={{ fontSize: 11.5, color: C.muted, fontWeight: 600 }}>Racha actual</div>
            <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 20, marginTop: 4 }}>
              {data.streak || 0} días 🔥
            </div>
          </Card>
          <Card>
            <div style={{ fontSize: 11.5, color: C.muted, fontWeight: 600 }}>Puntos</div>
            <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 20, marginTop: 4, color: C.gold }}>
              {data.points || 0}
            </div>
          </Card>
        </div>

        <Card style={{ marginTop: 12 }}>
          <div style={{ fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 14 }}>Esta semana</div>
          <div style={{ display: "flex", justifyContent: "space-between" }}>
            {minutesByDay.map((mins, i) => {
              const d = new Date(days7[i]);
              const label = DAY_LABELS[d.getDay()];
              const emoji = mins >= 45 ? "🟪" : mins > 0 ? "🟨" : "⬜";
              return (
                <div key={days7[i]} style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 4 }}>
                  <span style={{ fontSize: 18 }}>{emoji}</span>
                  <span style={{ fontSize: 10.5, color: C.muted }}>{label}</span>
                </div>
              );
            })}
          </div>
        </Card>

        <Card style={{ marginTop: 12 }}>
          <div style={{ fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 14 }}>Minutos por día</div>
          <div style={{ display: "flex", alignItems: "flex-end", gap: 10, height: 110 }}>
            {minutesByDay.map((mins, i) => {
              const d = new Date(days7[i]);
              const label = DAY_LABELS[d.getDay()];
              const h = Math.max(4, (mins / maxMinutes) * 100);
              return (
                <div key={days7[i]} style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "flex-end", height: "100%" }}>
                  <div style={{ fontSize: 10, color: C.muted, marginBottom: 6 }}>{mins > 0 ? mins : ""}</div>
                  <div style={{ width: "100%", height: `${h}%`, borderRadius: 6, background: mins > 0 ? C.purple : C.panelSoft }} />
                  <div style={{ fontSize: 10.5, color: C.muted, marginTop: 8 }}>{label}</div>
                </div>
              );
            })}
          </div>
        </Card>

        <div style={{ marginTop: 16, fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 10 }}>
          Historial reciente
        </div>
        {sessions.length === 0 ? (
          <div style={{ fontSize: 13, color: C.muted }}>Aún no hay sesiones registradas.</div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            {[...sessions].slice(-6).reverse().map((s, i) => (
              <div key={i} style={{ display: "flex", justifyContent: "space-between", background: C.panel, border: `1px solid ${C.border}`, borderRadius: 10, padding: "10px 14px", fontSize: 12.5 }}>
                <span style={{ color: C.muted }}>{s.date} · {s.subject || "Estudio"}</span>
                <span style={{ fontWeight: 600 }}>{s.minutes} min</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

function RewardsScreen({ data, update, onBack }) {
  const points = data.points || 0;
  const next = BADGES.find((b) => points < b.need);
  const [title, setTitle] = useState("");
  const [cost, setCost] = useState(30);
  const [error, setError] = useState("");

  function addReward() {
    if (!title.trim()) {
      setError("Escribe qué quieres poder canjear.");
      return;
    }
    if (!cost || Number(cost) <= 0) {
      setError("El costo en puntos debe ser mayor a 0.");
      return;
    }
    setError("");
    update((prev) => ({
      ...prev,
      customRewards: [...(prev.customRewards || []), { id: uid(), title: title.trim(), cost: Number(cost) }],
    }));
    setTitle("");
    setCost(30);
  }

  function removeReward(id) {
    update((prev) => ({ ...prev, customRewards: (prev.customRewards || []).filter((r) => r.id !== id) }));
  }

  function redeem(reward) {
    if (points < reward.cost) return;
    update((prev) => ({
      ...prev,
      points: (prev.points || 0) - reward.cost,
      redeemedLog: [...(prev.redeemedLog || []), { title: reward.title, cost: reward.cost, date: todayStr() }],
    }));
  }

  const customRewards = data.customRewards || [];
  const redeemedLog = data.redeemedLog || [];

  return (
    <div>
      <TopBack onBack={onBack} title="Recompensas" />
      <div style={{ padding: "10px 20px" }}>
        <Card style={{ textAlign: "center" }}>
          <div style={{ fontSize: 12, color: C.muted, fontWeight: 600 }}>Puntos acumulados</div>
          <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 34, color: C.gold, marginTop: 4 }}>
            {points}
          </div>
          {next && (
            <div style={{ marginTop: 12 }}>
              <div style={{ fontSize: 11.5, color: C.muted, marginBottom: 6 }}>
                {next.need - points} puntos para "{next.name}"
              </div>
              <ProgressBar pct={(points / next.need) * 100} color={C.gold} />
            </div>
          )}
        </Card>

        <div style={{ marginTop: 20, display: "flex", flexDirection: "column", gap: 8 }}>
          {BADGES.map((b) => {
            const unlocked = points >= b.need;
            return (
              <div
                key={b.name}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 12,
                  background: unlocked ? "rgba(242,184,75,0.10)" : C.panel,
                  border: `1px solid ${unlocked ? C.gold : C.border}`,
                  borderRadius: 12,
                  padding: "13px 14px",
                  opacity: unlocked ? 1 : 0.6,
                }}
              >
                <span style={{ fontSize: 22 }}>{b.icon}</span>
                <div>
                  <div style={{ fontWeight: 600, fontSize: 13.5 }}>{b.name}</div>
                  <div style={{ fontSize: 11.5, color: C.muted }}>{b.need} puntos</div>
                </div>
              </div>
            );
          })}
        </div>

        <div style={{ marginTop: 24, fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 10 }}>
          Canjea tus puntos por premios
        </div>
        <div style={{ fontSize: 11.5, color: C.muted, marginBottom: 12, lineHeight: 1.5 }}>
          Tú decides qué son los premios: algo real (tiempo libre, un antojo, salir con amigos) o algo
          simbólico. Al canjear se descuentan los puntos.
        </div>
        <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
          {customRewards.length === 0 && (
            <div style={{ fontSize: 13, color: C.muted }}>Todavía no tienes premios creados.</div>
          )}
          {customRewards.map((r) => {
            const canRedeem = points >= r.cost;
            return (
              <Card key={r.id} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexDirection: "row" }}>
                <div>
                  <div style={{ fontWeight: 600, fontSize: 13.5 }}>{r.title}</div>
                  <div style={{ fontSize: 11.5, color: C.muted, marginTop: 2 }}>{r.cost} puntos</div>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <button
                    onClick={() => redeem(r)}
                    disabled={!canRedeem}
                    style={{
                      fontFamily: "'Sora', sans-serif",
                      fontWeight: 600,
                      fontSize: 12.5,
                      padding: "9px 14px",
                      borderRadius: 10,
                      border: "none",
                      background: canRedeem ? C.gold : C.panelSoft,
                      color: canRedeem ? "#2B1D02" : C.muted,
                      cursor: canRedeem ? "pointer" : "default",
                    }}
                  >
                    Canjear
                  </button>
                  <button
                    onClick={() => removeReward(r.id)}
                    aria-label="Eliminar premio"
                    style={{ background: "none", border: "none", color: C.muted, cursor: "pointer", fontSize: 15 }}
                  >
                    ✕
                  </button>
                </div>
              </Card>
            );
          })}
        </div>

        <Card style={{ marginTop: 14 }}>
          <TextField label="Nuevo premio" value={title} onChange={setTitle} placeholder="Ej: Pedir mi comida favorita" />
          <TextField label="Costo en puntos" value={cost} onChange={setCost} type="number" />
          {error && <div style={{ color: C.danger, fontSize: 12, marginBottom: 8 }}>{error}</div>}
          <PrimaryButton onClick={addReward} style={{ width: "100%" }}>
            Agregar premio
          </PrimaryButton>
        </Card>

        {redeemedLog.length > 0 && (
          <>
            <div style={{ marginTop: 22, fontSize: 13, fontWeight: 600, color: C.muted, marginBottom: 10 }}>
              Canjeado recientemente
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
              {[...redeemedLog].slice(-5).reverse().map((r, i) => (
                <div
                  key={i}
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    background: C.panel,
                    border: `1px solid ${C.border}`,
                    borderRadius: 10,
                    padding: "10px 14px",
                    fontSize: 12.5,
                  }}
                >
                  <span style={{ color: C.muted }}>{r.date} · {r.title}</span>
                  <span style={{ fontWeight: 600 }}>-{r.cost} pts</span>
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  );
}

