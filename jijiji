function SessionScreen({ onBack, onFinish }) {
  const [subject, setSubject] = useState(SUBJECTS[0]);
  const [customSubject, setCustomSubject] = useState("");
  const [objective, setObjective] = useState("");
  const [duration, setDuration] = useState(25);
  const [pomodoro, setPomodoro] = useState(false);
  const [phase, setPhase] = useState("work");
  const [secondsLeft, setSecondsLeft] = useState(25 * 60);
  const [running, setRunning] = useState(false);
  const [result, setResult] = useState(null);
  const workedSecondsRef = useRef(0);
  const intervalRef = useRef(null);

  useEffect(() => {
    if (!running) return;
    intervalRef.current = setInterval(() => {
      setSecondsLeft((s) => {
        if (s <= 1) {
          clearInterval(intervalRef.current);
          handlePhaseEnd();
          return 0;
        }
        if (phase === "work") workedSecondsRef.current += 1;
        return s - 1;
      });
    }, 1000);
    return () => clearInterval(intervalRef.current);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [running, phase]);

  function handlePhaseEnd() {
    setRunning(false);
    if (phase === "work" && pomodoro) {
      setPhase("break");
      setSecondsLeft(5 * 60);
      setRunning(true);
    } else {
      finish(true);
    }
  }

  function finish(natural) {
    setRunning(false);
    clearInterval(intervalRef.current);
    const mins = Math.max(1, Math.round(workedSecondsRef.current / 60));
    const subj = subject === "Otra" ? customSubject || "Otra materia" : subject;
    const earned = onFinish({ subject: subj, minutes: mins, objective });
    setResult({ mins, earned });
  }

  function startPause() {
    if (secondsLeft === 0 && phase === "work") {
      setSecondsLeft(duration * 60);
    }
    setRunning((r) => !r);
  }

  function changeDuration(m) {
    if (running || workedSecondsRef.current > 0) return;
    setDuration(m);
    setSecondsLeft(m * 60);
  }

  const RADIUS = 100;
  const CIRC = 2 * Math.PI * RADIUS;
  const totalPhaseSeconds = phase === "work" ? duration * 60 : 5 * 60;
  const progress = 1 - secondsLeft / totalPhaseSeconds;

  if (result) {
    return (
      <div style={{ padding: "24px 20px" }}>
        <TopBack onBack={onBack} title="Sesión de estudio" />
        <div style={{ textAlign: "center", padding: "40px 10px" }}>
          <div style={{ fontSize: 40 }}>🎉</div>
          <div style={{ fontFamily: "'Sora', sans-serif", fontWeight: 700, fontSize: 20, marginTop: 12 }}>
            ¡Sesión completada!
          </div>
          <div style={{ color: C.muted, marginTop: 8, fontSize: 14 }}>
            Has estudiado {result.mins} minuto{result.mins === 1 ? "" : "s"}.
          </div>
          <div style={{ color: C.gold, fontWeight: 700, marginTop: 10, fontSize: 16 }}>
            +{result.earned} puntos ⭐
          </div>
          <PrimaryButton onClick={onBack} style={{ marginTop: 30 }}>
            Volver al menú
          </PrimaryButton>
        </div>
      </div>
    );
  }

  return (
    <div style={{ padding: "0 0 20px" }}>
      <TopBack onBack={onBack} title="Sesión de estudio" />
      <div style={{ padding: "10px 20px" }}>
        <TextField
          label="Materia"
          value=""
          onChange={() => {}}
          placeholder=""
          type="hidden"
        />
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap", marginTop: -8, marginBottom: 12 }}>
          {SUBJECTS.map((s) => (
            <button
              key={s}
              onClick={() => setSubject(s)}
              disabled={running}
              style={{
                fontSize: 12.5,
                fontWeight: 600,
                padding: "8px 13px",
                borderRadius: 999,
                border: `1px solid ${subject === s ? C.purple : C.border}`,
                background: subject === s ? C.purpleSoft : "transparent",
                color: subject === s ? C.lavender : C.muted,
                cursor: running ? "default" : "pointer",
              }}
            >
              {s}
            </button>
          ))}
        </div>
        {subject === "Otra" && (
          <TextField
            value={customSubject}
            onChange={setCustomSubject}
            placeholder="Escribe la materia"
          />
        )}
        <TextField
          label="Meta de la sesión (opcional)"
          value={objective}
          onChange={setObjective}
          placeholder="Ej: completar ejercicios 1 al 10"
        />

        <div style={{ display: "flex", gap: 8, margin: "6px 0 22px", justifyContent: "center" }}>
          {DURATIONS.map((m) => (
            <button
              key={m}
              onClick={() => changeDuration(m)}
              disabled={running}
              style={{
                fontWeight: 600,
                fontSize: 13,
                padding: "8px 15px",
                borderRadius: 999,
                border: `1px solid ${duration === m ? C.purple : C.border}`,
                background: duration === m ? C.purpleSoft : "transparent",
                color: duration === m ? C.lavender : C.muted,
                cursor: running ? "default" : "pointer",
                opacity: running ? 0.5 : 1,
              }}
            >
              {m} min
            </button>
          ))}
        </div>

        <label style={{ display: "flex", alignItems: "center", gap: 8, fontSize: 12.5, color: C.muted, marginBottom: 18 }}>
          <input type="checkbox" checked={pomodoro} onChange={(e) => setPomodoro(e.target.checked)} disabled={running} />
          Modo Pomodoro (5 min de descanso al terminar)
        </label>

        <div style={{ display: "flex", justifyContent: "center" }}>
          <div style={{ position: "relative" }}>
            <svg width="240" height="240" viewBox="0 0 240 240">
              <circle cx="120" cy="120" r={RADIUS} fill="none" stroke={C.panelSoft} strokeWidth="13" />
              <circle
                cx="120"
                cy="120"
                r={RADIUS}
                fill="none"
                stroke={phase === "work" ? C.purple : C.mint}
                strokeWidth="13"
                strokeLinecap="round"
                strokeDasharray={`${CIRC * progress} ${CIRC}`}
                transform="rotate(-90 120 120)"
                style={{ transition: "stroke-dasharray 1s linear" }}
              />
            </svg>
            <div
              style={{
                position: "absolute",
                inset: 0,
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <div style={{ fontFamily: "'JetBrains Mono', monospace", fontWeight: 700, fontSize: 38 }}>
                {fmtTime(secondsLeft)}
              </div>
              <div style={{ fontSize: 11.5, color: C.muted, marginTop: 4 }}>
                {phase === "work" ? "enfoque" : "descanso"}
              </div>
            </div>
          </div>
        </div>

        <div style={{ display: "flex", gap: 10, justifyContent: "center", marginTop: 24 }}>
          <PrimaryButton onClick={startPause}>{running ? "Pausar" : "Iniciar"}</PrimaryButton>
          <GhostButton onClick={() => finish(false)}>Finalizar</GhostButton>
        </div>
      </div>
    </div>
  );
}

